#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/* generated by scripts/gen_fw.py -- 66 key positions (right r1/c6 = 14 mm trackball) */

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
        zmk,battery = &non_lipo_battery;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,13) RC(0,12) RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,13) RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,13) RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,12) RC(4,11) RC(4,10) RC(4,9) RC(4,8) RC(4,7)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "tsuki65";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys  //                     w   h     x     y rot rx ry
            = <&key_physical_attrs 100 100     0    47 0 0 0>
            , <&key_physical_attrs 100 100   100    47 0 0 0>
            , <&key_physical_attrs 100 100   200    18 0 0 0>
            , <&key_physical_attrs 100 100   300     0 0 0 0>
            , <&key_physical_attrs 100 100   400    18 0 0 0>
            , <&key_physical_attrs 100 100   500    29 0 0 0>
            , <&key_physical_attrs 100 100   600    29 0 0 0>
            , <&key_physical_attrs 100 100  1106    29 0 0 0>
            , <&key_physical_attrs 100 100  1206    29 0 0 0>
            , <&key_physical_attrs 100 100  1306    18 0 0 0>
            , <&key_physical_attrs 100 100  1406     0 0 0 0>
            , <&key_physical_attrs 100 100  1506    18 0 0 0>
            , <&key_physical_attrs 100 100  1606    47 0 0 0>
            , <&key_physical_attrs 100 100  1706    47 0 0 0>
            , <&key_physical_attrs 100 100     0   147 0 0 0>
            , <&key_physical_attrs 100 100   100   147 0 0 0>
            , <&key_physical_attrs 100 100   200   118 0 0 0>
            , <&key_physical_attrs 100 100   300   100 0 0 0>
            , <&key_physical_attrs 100 100   400   118 0 0 0>
            , <&key_physical_attrs 100 100   500   129 0 0 0>
            , <&key_physical_attrs 100 100   600   129 0 0 0>
            , <&key_physical_attrs 100 100  1106   129 0 0 0>
            , <&key_physical_attrs 100 100  1206   129 0 0 0>
            , <&key_physical_attrs 100 100  1306   118 0 0 0>
            , <&key_physical_attrs 100 100  1406   100 0 0 0>
            , <&key_physical_attrs 100 100  1506   118 0 0 0>
            , <&key_physical_attrs 100 100  1606   147 0 0 0>
            , <&key_physical_attrs 100 100  1706   147 0 0 0>
            , <&key_physical_attrs 100 100     0   247 0 0 0>
            , <&key_physical_attrs 100 100   100   247 0 0 0>
            , <&key_physical_attrs 100 100   200   218 0 0 0>
            , <&key_physical_attrs 100 100   300   200 0 0 0>
            , <&key_physical_attrs 100 100   400   218 0 0 0>
            , <&key_physical_attrs 100 100   500   229 0 0 0>
            , <&key_physical_attrs 100 100   600   229 0 0 0>
            , <&key_physical_attrs 100 100  1106   229 0 0 0>
            , <&key_physical_attrs 100 100  1206   229 0 0 0>
            , <&key_physical_attrs 100 100  1306   218 0 0 0>
            , <&key_physical_attrs 100 100  1406   200 0 0 0>
            , <&key_physical_attrs 100 100  1506   218 0 0 0>
            , <&key_physical_attrs 100 100  1606   247 0 0 0>
            , <&key_physical_attrs 100 100  1706   247 0 0 0>
            , <&key_physical_attrs 100 100     0   347 0 0 0>
            , <&key_physical_attrs 100 100   100   347 0 0 0>
            , <&key_physical_attrs 100 100   200   318 0 0 0>
            , <&key_physical_attrs 100 100   300   300 0 0 0>
            , <&key_physical_attrs 100 100   400   318 0 0 0>
            , <&key_physical_attrs 100 100   500   329 0 0 0>
            , <&key_physical_attrs 100 100  1206   329 0 0 0>
            , <&key_physical_attrs 100 100  1306   318 0 0 0>
            , <&key_physical_attrs 100 100  1406   300 0 0 0>
            , <&key_physical_attrs 100 100  1506   318 0 0 0>
            , <&key_physical_attrs 100 100  1606   347 0 0 0>
            , <&key_physical_attrs 100 100  1706   347 0 0 0>
            , <&key_physical_attrs 100 100     0   447 0 0 0>
            , <&key_physical_attrs 100 100   100   447 0 0 0>
            , <&key_physical_attrs 100 100   200   418 0 0 0>
            , <&key_physical_attrs 100 100   300   412 0 0 0>
            , <&key_physical_attrs 100 100   400   429 0 0 0>
            , <&key_physical_attrs 100 100   500   441 0 0 0>
            , <&key_physical_attrs 100 100  1206   441 0 0 0>
            , <&key_physical_attrs 100 100  1306   429 0 0 0>
            , <&key_physical_attrs 100 100  1406   412 0 0 0>
            , <&key_physical_attrs 100 100  1506   418 0 0 0>
            , <&key_physical_attrs 100 100  1606   447 0 0 0>
            , <&key_physical_attrs 100 100  1706   447 0 0 0>
            ;
    };

    /* BMP Boost pin assignment is identical to torabo-tsuki LP */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        col-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 15   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 23   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 10   (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 0    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio0 9    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&gpio1 3    (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        row-gpios
            = <&gpio0 5 (GPIO_ACTIVE_HIGH)>,
            <&gpio0 0  (GPIO_ACTIVE_HIGH)>,
            <&gpio0 30 (GPIO_ACTIVE_HIGH)>,
            <&gpio0 3  (GPIO_ACTIVE_HIGH)>,
            <&gpio1 14 (GPIO_ACTIVE_HIGH)>
            ;
        wakeup-source;
    };

    leds {
        compatible = "gpio-leds";
        status_led: status_led {
            gpios = <&bmp 2 GPIO_ACTIVE_HIGH>;
            label = "Status LED";
        };
    };

    status_led_device: status_led_device {
        compatible = "zmk,status-led";
        led = <&status_led>;
    };

    bootloader_trigger: bootloader_trigger {
        compatible = "zmk,cdc-acm-bootloader-trigger";
    };

    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    vbatt: vbatt {
        status = "disabled";
    };
    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 18)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 16)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 18)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 16)>,
                    <NRF_PSEL(SPIM_MISO, 0, 16)>;
        };
        low-power-enable;
    };
};
